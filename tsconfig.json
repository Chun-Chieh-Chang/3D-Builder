{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // Vite's upcoming native config loader needs import specifiers to carry the extension, so apps/*/vite.config.ts
    // imports './dev/autoClose.ts'. TypeScript only accepts that when this is on; noEmit above already allows it.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["packages/*/src", "packages/*/test", "apps/*/src", "apps/*/test", "tests", "scripts", "vitest.config.ts", "apps/*/vite.config.ts", "apps/*/dev"]
}
