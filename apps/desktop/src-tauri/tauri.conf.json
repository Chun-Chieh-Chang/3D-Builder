{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3D-Builder",
  "version": "0.1.0",
  "identifier": "app.3dbuilder.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://127.0.0.1:5391",
    "beforeDevCommand": "npm run dev -w @3db/web",
    "beforeBuildCommand": "npm run build -w @3db/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "3D-Builder",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["TradChinese", "English"]
      }
    }
  }
}
